# OPEN MIND AI — provider configuration
# Never commit real credentials. Copy to .env locally and fill values.
BRAVE_SEARCH_API_KEY=
GOOGLE_MAPS_API_KEY=
OPEN_MIND_CHROMA_PATH=./data/chroma
OPEN_MIND_OUTPUTS=/outputs

# SMART AI local inference (optional; no cloud key required)
# SMART_AI_LOCAL_URL=http://127.0.0.1:11434
# SMART_AI_LOCAL_MODEL=smart-time-local
# SMART_AI_LOCAL_TOKEN=replace-with-a-long-random-secret

# Football / Sports Fixtures (Either RapidAPI or API-Football)
RAPIDAPI_KEY=
API_FOOTBALL_KEY=

# Live News Service
GNEWS_API_KEY=

# Routing & Geocoding (Mapbox / Google Maps / TomTom)
MAPBOX_ACCESS_TOKEN=
TOMTOM_API_KEY=

# Client Map Tiles (MapTiler)
VITE_MAPTILER_API_KEY=

# SMS & Verification Providers (Twilio / MessageCentral / Webhook)
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
MESSAGECENTRAL_CUSTOMER_ID=
MESSAGECENTRAL_KEY=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_SECRET=

# Password reset email uses direct SMTP only (Gmail uses an App Password in SMTP_PASS).
# Never commit real credentials. The runtime must provide valid values before reset email can work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Optional Cloudflare Turnstile enforcement. Keep false until the frontend is configured.
TURNSTILE_ENFORCE=false
TURNSTILE_SECRET_KEY=
# Set true in the frontend hosting environment only after the site key is configured.
VITE_TURNSTILE_ENABLED=false
VITE_TURNSTILE_SITE_KEY=

# App Administration & Payment Defaults
PROGRAM_OWNER_USER_ID=
PROGRAM_OWNER_ACTIVATION_KEY=
OWNER_WALLET_NUMBER=01126621962
OWNER_INSTAPAY_ADDRESS=01126621962
TRIP_SEARCH_COST_EGP=5
WALLET_TOPUP_MIN_EGP=5
WALLET_TOPUP_MAX_EGP=10000

# Optional local SMART VOICE DNA GPU provider
# SMART_VOICE_DNA_PROVIDER_URL=http://127.0.0.1:8000/synthesize
# SMART_VOICE_DNA_PROVIDER_TOKEN=replace-with-a-long-random-secret
# SMART_VOICE_DNA_PROVIDER_TIMEOUT_MS=120000
# SMART_VOICE_DNA_MAX_REFERENCE_BYTES=8388608
# SMART_VOICE_DNA_MAX_REQUESTS_PER_MINUTE=8

# Groq provider (server-side only; never prefix with VITE_)
# GROQ_API_KEY=replace-with-groq-secret
# GROQ_MODEL=openai/gpt-oss-120b


# Required server-side secrets: generate independent random values of at least 32 characters.
# Never commit real values. RATE_LIMIT_HASH_SECRET has no hard-coded fallback.
PASSWORD_RESET_HMAC_SECRET=
RATE_LIMIT_HASH_SECRET=
# Required to sign short-lived role-selection tickets and revocable app-session JWTs.
JWT_SECRET=
OWNER_EMAILS=

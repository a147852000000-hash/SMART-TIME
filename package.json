{
  "name": "open-mind-ai",
  "private": true,
  "version": "25.7.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:open-mind": "tsx backend/ai/openMindBrain.test.ts && tsx backend/ai/openMindE2E.test.ts",
    "validate:smart-ai": "node scripts/validate-smart-ai-datasets.mjs",
    "train:smart-ai": "python infra/smart-ai/training/train_smart_ai.py",
    "eval:smart-ai": "python infra/smart-ai/training/evaluate_smart_ai.py",
    "audit:smart-ai": "node scripts/audit-smart-ai-training.mjs",
    "stats:smart-ai": "node scripts/smart-ai-training-stats.mjs",
    "score:smart-ai": "node scripts/score-smart-ai-eval.mjs",
    "verify:canonical-schema": "node scripts/verify-canonical-schema.mjs",
    "verify:phase2-storage-schema": "node scripts/verify-phase2-storage-schema.mjs",
    "verify:phase3-storage-keys": "node scripts/verify-phase3-storage-keys.mjs",
    "verify:phase4-no-direct-storage": "node scripts/verify-phase4-no-direct-storage.mjs",
    "verify:phase5-finance-migration": "node scripts/verify-phase5-finance-migration.mjs",
    "verify:phase5-ai-canonical": "node scripts/verify-phase5-ai-canonical.mjs",
    "verify:phase5-no-duplicate-writes": "node scripts/verify-phase5-no-duplicate-writes.mjs",
    "verify:phase5-final": "node scripts/verify-phase5-final.mjs",
    "validate:smart-ai-v2-json": "node scripts/validate-smart-ai-v2-json.mjs",
    "test:phase2-db": "tsx backend/database.phase2.test.ts",
    "test:phase3-api": "node scripts/test-phase3-api.mjs",
    "verify:phase4-dataset-provenance": "node scripts/verify-phase4-dataset-provenance.mjs",
    "verify:phase5-model-data-registry": "node scripts/verify-phase5-model-data-registry.mjs",
    "verify:phase6-training-runtime": "node scripts/verify-phase6-training-runtime.mjs",
    "verify:phase12-stt-corpus": "node scripts/verify-phase12-stt-corpus.mjs",
    "test:groq-provider": "tsx backend/ai/providers/groqProvider.test.ts",
    "test:turnstile": "tsx backend/security/turnstile.test.ts",
    "verify:phase-a2-stt": "node scripts/verify-phase-a2-stt.mjs",
    "test:password-reset-email": "tsx backend/auth/passwordResetEmail.test.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vis.gl/react-google-maps": "^1.10.0",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3",
    "ws": "^8.21.3",
    "leaflet": "^1.9.4",
    "esbuild": "^0.25.0",
    "livekit-client": "^2.15.6",
    "nodemailer": "^7.0.11"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "@types/leaflet": "^1.9.20"
  },
  "optionalDependencies": {
    "exceljs": "^4.4.0",
    "docx": "^9.5.1",
    "pdf-lib": "^1.17.1"
  }
}
